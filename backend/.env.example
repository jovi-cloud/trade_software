# Copy to backend/.env and edit. Every value below is optional -
# the application starts with sensible defaults if this file does not exist.

# --- Application ---
ENV=dev
DEBUG=true

# --- Server (loopback only: single-user local application) ---
HOST=127.0.0.1
PORT=8000

# --- Storage: all user state (database, market data, artifacts, logs) ---
# Relative paths are resolved against the repository root.
DATA_DIR=data

# --- Database: leave unset to use <DATA_DIR>/app.db ---
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_TO_FILE=true

# --- Jobs ---
JOB_MAX_WORKERS=2

# --- CORS: the Vite dev server ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
